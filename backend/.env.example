# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=yaoke

# 中文 Embedding / Rerank
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
ENABLE_RERANK=false

# Ollama（宿主机手工运行 backend 时使用 localhost；Docker Compose 会显式覆盖为 host.docker.internal）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ornith-1.5:9b
OLLAMA_KEEP_ALIVE=30m

# 可选：OpenAI-compatible API；基础 RAG 路径可使用。P1.6 Agent 主链默认使用本地 Ollama/Ornith。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Controlled Web Search（无需额外付费 API Key）
WEB_SEARCH_ENABLED=true
WEB_SEARCH_BACKEND=auto
WEB_SEARCH_REGION=cn-zh
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8

# Ornith Agent
AGENT_MODE_DEFAULT=auto
AGENT_MAX_TOOL_ROUNDS=3
AGENT_LLM_TIMEOUT_SECONDS=120
# 有 Tool Schema 的路由轮允许 reasoning；证据综合轮关闭 think，以降低知识问答延迟。
AGENT_THINK_TOOL_ROUTING=true
AGENT_THINK_SYNTHESIS=false
AGENT_NUM_PREDICT_TOOL_ROUTING=768
AGENT_NUM_PREDICT_SYNTHESIS=512
# Conversation 只把最近完成的 8 条 user/assistant 消息送回模型，防止上下文无限增长。
AGENT_HISTORY_MAX_MESSAGES=8
# Local 是显式企业知识模式：直接执行受 RBAC 保护的 enterprise_search，再调用一次 Ornith 合成答案。
AGENT_LOCAL_FAST_PATH=true

# Conversation persistence
# 本地从 backend/ 启动时落到 backend/data/conversations.db；Docker 中为 /app/data/conversations.db。
# docker-compose 已挂载 ./backend/data:/app/data，因此容器重建后会话历史仍保留。
CONVERSATION_DB_PATH=data/conversations.db

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MAX_FILE_SIZE_MB=20
# P1.6：Vector/BM25 都索引 文档标题 + 章节标题 + 知识库 + 正文；版本变化时 Demo 自动重建索引。
RETRIEVAL_SCHEMA_VERSION=p16-metadata-rrf-v1
# Hybrid 两路分别扩大候选后用 RRF 融合；最终仍只返回 TOP_K 给 LLM。
RETRIEVAL_VECTOR_CANDIDATES=30
RETRIEVAL_BM25_CANDIDATES=30
RETRIEVAL_RRF_K=60
# 显式启用 CrossEncoder 时只重排前 12 个候选，避免对整个召回池做慢推理。
RETRIEVAL_RERANK_CANDIDATES=12
# 多轮短追问最多继承 320 字上一轮检索主题，不额外调用 LLM 做 rewrite。
RETRIEVAL_QUERY_CONTEXT_MAX_CHARS=320
# 兼容旧配置；P1.6 Hybrid 已改为 RRF，不再依赖该权重。
VECTOR_WEIGHT=0.70
# BM25 不再每次从 Qdrant 全量重建；同一权限范围缓存 5 分钟，入库/删除会立即失效。
BM25_CACHE_TTL_SECONDS=300
# Hybrid 时 Vector 与 BM25 两路并行，降低首轮检索 wall-clock latency。
RETRIEVAL_PARALLEL_HYBRID=true

# Auth（生产环境必须替换；scripts/deploy.ps1 会在仍为默认值时自动生成随机本地 secret）
JWT_SECRET=change-me-before-production-yaoke-demo-secret
JWT_EXPIRE_HOURS=8

# Demo bootstrap：本地从 backend/ 启动时使用 ../demo-data
DEMO_DATA_DIR=../demo-data
