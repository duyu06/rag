# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=yaoke

# 中文 Embedding / Rerank
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
ENABLE_RERANK=false

# Ollama（宿主机手工运行 backend 时使用 localhost；Docker Compose 会显式覆盖为 host.docker.internal）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ornith-1.5:9b

# 可选：OpenAI-compatible API；基础 RAG 路径可使用。P1.4 Agent 默认使用本地 Ollama/Ornith Tool Calling。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Controlled Web Search（无需额外付费 API Key）
WEB_SEARCH_ENABLED=true
WEB_SEARCH_BACKEND=auto
WEB_SEARCH_REGION=cn-zh
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8

# Ornith Agent
AGENT_MODE_DEFAULT=auto
AGENT_MAX_TOOL_ROUNDS=3
AGENT_LLM_TIMEOUT_SECONDS=120

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
VECTOR_WEIGHT=0.70
TOP_K=5
MAX_FILE_SIZE_MB=20

# Auth（生产环境必须替换）
JWT_SECRET=change-me-before-production-yaoke-demo-secret
JWT_EXPIRE_HOURS=8

# Demo bootstrap：本地从 backend/ 启动时使用 ../demo-data
DEMO_DATA_DIR=../demo-data
