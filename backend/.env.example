# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nexuskb

# 中文 Embedding / Rerank
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
ENABLE_RERANK=false

# Ollama（默认）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# 可选：OpenAI-compatible API；配置 API Key 后优先使用
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
VECTOR_WEIGHT=0.70
TOP_K=5
MAX_FILE_SIZE_MB=20

# Auth（生产环境必须替换）
JWT_SECRET=change-me-before-production-nexuskb-demo-secret
JWT_EXPIRE_HOURS=8

# Demo bootstrap：本地从 backend/ 启动时使用 ../demo-data
DEMO_DATA_DIR=../demo-data
