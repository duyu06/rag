# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=yaoke

# 中文 Embedding / Rerank
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
ENABLE_RERANK=false
RERANK_PROVIDER=local

# TypeSafe System One（可选，默认关闭；Key 只允许写入 backend/.env 或生产 Secret Store）
# 注意：以下所有键都只在进程启动时读取一次——改 backend/.env 后需重启后端才生效。
TYPESAFE_ENABLED=false
# 判定层五档（enabled=false 时恒等价 off，mode 不会反向打开它）：
#   off       从不调用 TypeSafe，纯本地序。
#   shadow    恒调用但只观测，不改变用户可见顺序（默认，与 V1 现网口径一致）。
#   selective 仅规则信号 should_judge() 命中才调用，并应用判定路由（生产建议值）。
#   active    除"高置信 + 无风险 + 单一事实"外都调用，并应用路由。
#   strict    恒调用并应用路由（= V1 active，验收对照用）。
# 生产建议：TYPESAFE_MODE=selective（达成 calls/query P50<=4、input tokens 降 >=30%）。
TYPESAFE_MODE=shadow
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
# 单请求 client 超时上限（秒）；批次级软/硬预算见下面 *_TIMEOUT_MS。
TYPESAFE_TIMEOUT_SECONDS=8
# 判定段超时预算：超过软线只记 slow 计数，超过硬线取消未完成批次并退本地序。
# 需满足 0 < soft <= hard（app/resilience.TimeoutBudget 构造期校验）。
# 预算对象是**一个判定批次**（每批次一条新预算，批次间不共享），故终值按"批次墙钟"标定：
# Task 8 段A 实测本 API 单请求 P95=1835ms、段B 实测 3-8 请求批次的墙钟尾 3.0-4.9s，
# spec §8 预留的验收前标定动作据此把 1800 定为 3000（1800 属低于现网 P95 的配置错配）。
TYPESAFE_SOFT_TIMEOUT_MS=1200
TYPESAFE_HARD_TIMEOUT_MS=3000
# 并发外呼上限；V2 由 4 提到 6（配合动态 TopK 与缓存，单查询外呼数反而下降）。
TYPESAFE_MAX_CONCURRENCY=6
# 动态 TopK：判定前池尺寸按 CE 分差/置信度分档，替代 V1 固定 6/12。
# 旧键保留：TYPESAFE_CANDIDATES / TYPESAFE_COMPOUND_CANDIDATES 仍是判定前基础池与 compound 档取值。
TYPESAFE_CANDIDATES=6
TYPESAFE_MIN_CANDIDATES=3
TYPESAFE_MAX_CANDIDATES=6
TYPESAFE_COMPOUND_CANDIDATES=8
TYPESAFE_LOW_CONFIDENCE_CANDIDATES=12
# 语义去重：cosine 达阈值即合并，保留高分块。
TYPESAFE_DEDUP_COSINE=0.97
# 进程内判定缓存（LRU + TTL，不做持久化）；文档重建后内容 hash 自然失效。
TYPESAFE_CACHE_ENABLED=true
TYPESAFE_CACHE_TTL_SECONDS=86400
TYPESAFE_CACHE_MAX_ENTRIES=2048
# 熔断：OPEN 期间不发起判定、不标 degraded（主动避险），退本地序并记 circuit_open。
# window 下限 8 与 CircuitBreaker 构造约束同轨；half_open_probes 为恢复探测名额。
TYPESAFE_BREAKER_ENABLED=true
TYPESAFE_BREAKER_WINDOW=20
TYPESAFE_BREAKER_FAILURE_RATIO=0.30
TYPESAFE_BREAKER_OPEN_SECONDS=60
TYPESAFE_BREAKER_HALF_OPEN_PROBES=3
TYPESAFE_MAX_PASSAGE_CHARS=2400
# 这些仅是 shadow 初始值，active 前必须用本项目中文评测集校准。
TYPESAFE_INJECTION_MAX=0.70
TYPESAFE_CONTRADICTS_MIN=0.70
TYPESAFE_RELEVANT_MIN=0.45
TYPESAFE_EVIDENCE_MIN=0.55
# margin/floor 在首轮 59 题 strict 对照中标定，验收前允许调整并记录最终值。
TYPESAFE_HIGH_MARGIN=0.25
TYPESAFE_MEDIUM_MARGIN=0.10
TYPESAFE_CONFIDENCE_FLOOR=0.20
TYPESAFE_INPUT_PRICE_PER_MILLION_USD=0.042

# Ollama（宿主机手工运行 backend 时使用 localhost；Docker Compose 会显式覆盖为 host.docker.internal）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ornith-1.5:9b
OLLAMA_KEEP_ALIVE=30m

# 可选：OpenAI-compatible API；基础 RAG 路径可使用。P1.6 Agent 主链默认使用本地 Ollama/Ornith。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Controlled Web Search（无需额外付费 API Key）
WEB_SEARCH_ENABLED=true
WEB_SEARCH_BACKEND=auto
WEB_SEARCH_REGION=cn-zh
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8

# Ornith Agent
AGENT_MODE_DEFAULT=auto
AGENT_MAX_TOOL_ROUNDS=3
AGENT_LLM_TIMEOUT_SECONDS=120
# 有 Tool Schema 的路由轮允许 reasoning；证据综合轮关闭 think，以降低知识问答延迟。
AGENT_THINK_TOOL_ROUTING=true
AGENT_THINK_SYNTHESIS=false
AGENT_NUM_PREDICT_TOOL_ROUTING=768
AGENT_NUM_PREDICT_SYNTHESIS=512
# Conversation 只把最近完成的 8 条 user/assistant 消息送回模型，防止上下文无限增长。
AGENT_HISTORY_MAX_MESSAGES=8
# Local 是显式企业知识模式：直接执行受 RBAC 保护的 enterprise_search，再调用一次 Ornith 合成答案。
AGENT_LOCAL_FAST_PATH=true

# Conversation persistence
# 本地从 backend/ 启动时落到 backend/data/conversations.db；Docker 中为 /app/data/conversations.db。
# docker-compose 已挂载 ./backend/data:/app/data，因此容器重建后会话历史仍保留。
CONVERSATION_DB_PATH=data/conversations.db

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MAX_FILE_SIZE_MB=20
# P1.6：Vector/BM25 都索引 文档标题 + 章节标题 + 知识库 + 正文；版本变化时 Demo 自动重建索引。
RETRIEVAL_SCHEMA_VERSION=p16-metadata-rrf-v2
# Hybrid 两路分别扩大候选后用 RRF 融合；最终仍只返回 TOP_K 给 LLM。
RETRIEVAL_VECTOR_CANDIDATES=30
RETRIEVAL_BM25_CANDIDATES=30
RETRIEVAL_RRF_K=60
# 显式启用 CrossEncoder 时只重排前 12 个候选，避免对整个召回池做慢推理。
RETRIEVAL_RERANK_CANDIDATES=6
# 纯 Vector 模式使用 BGE query instruction；Hybrid 经 real-BGE A/B 验证，raw query + RRF 的 MRR 更高。
RETRIEVAL_VECTOR_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# 细粒度章节切块后优先保证来源多样性：最终 TopK 默认每个文档最多优先占 2 个位置；候选不足时自动回填，不减少结果数。
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
# 多轮短追问最多继承 320 字上一轮检索主题，不额外调用 LLM 做 rewrite。
RETRIEVAL_QUERY_CONTEXT_MAX_CHARS=320
# 兼容旧配置；P1.6 Hybrid 已改为 RRF，不再依赖该权重。
VECTOR_WEIGHT=0.70
# BM25 不再每次从 Qdrant 全量重建；同一权限范围缓存 5 分钟，入库/删除会立即失效。
BM25_CACHE_TTL_SECONDS=300
# Hybrid 时 Vector 与 BM25 两路并行，降低首轮检索 wall-clock latency。
RETRIEVAL_PARALLEL_HYBRID=true

# Auth（生产环境必须替换；scripts/deploy.ps1 会在仍为默认值时自动生成随机本地 secret）
JWT_SECRET=change-me-before-production-yaoke-demo-secret
JWT_EXPIRE_HOURS=8

# Demo bootstrap：本地从 backend/ 启动时使用 ../demo-data
DEMO_DATA_DIR=../demo-data

# 飞书权限桥接（默认关闭；启用五步与失败收紧语义见 backend/app/identity/README.md）
# 注意：FEISHU_RULES_FILE 相对路径以 WORKDIR(backend/) 为基准；容器镜像已 COPY config。
# 修改规则文件或 USERS 里的 feishu_open_id 绑定后需重启（reset_resolver 只清单例缓存）。
FEISHU_PERMISSIONS_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT_SECONDS=3
FEISHU_CACHE_TTL_SECONDS=900
FEISHU_CACHE_STALE_SECONDS=86400
FEISHU_RULES_FILE=config/feishu_permissions.json

# Model Router V2.3（统一 LLM 出口：注册表 / 规则路由 / failover / 逐 provider 熔断 / 总预算 / 记账）
# 注意：以下键都在进程启动时读取一次，改 backend/.env 后需重启后端才生效。
# 关闭开关 = 三条链路（RAG 非流式 / SSE 流式 / Agent 工具回路）回到 legacy 原行为，
# 仅作 V2.3 的紧急回退用，下一稳定版会删除该分支——长期方案不是关掉路由。
LLM_ROUTER_ENABLED=true
# 声明式模型注册表（相对路径以 WORKDIR(backend/) 为基准，容器镜像已 COPY config）。
# 该文件**零 secret**：出现 api_key / base_url 字段即校验失败（D1）。
# 凭据 env 约定：{PROVIDER 大写}_API_KEY / _BASE_URL / _MODEL_OVERRIDE；
# ollama 只读 OLLAMA_BASE_URL（无 key）；内置 openai 条目复用上面的 OPENAI_*，不产生第二套配置。
LLM_REGISTRY_FILE=config/llm_registry.json
# 总预算制：一次请求的 3 个 attempt **共享**这 30s（不做每模型相加）；
# 每个 attempt 的实际超时 = min(LLM_MODEL_TIMEOUT_SECONDS, 预算剩余)。
LLM_TOTAL_BUDGET_MS=30000
LLM_MODEL_TIMEOUT_SECONDS=20
# 当前模型的重试次数，只对 retryable 类错误（408/429/5xx/超时/连接失败）生效；
# 模型加载失败（model_unavailable）不重试当前模型——换下一个候选更快。
LLM_RETRY_PER_MODEL=1
# 逐 provider 熔断：OPEN 期间该 provider 的候选直接跳过并在 reason 记 CIRCUIT_OPEN，
# 不计入 degraded（D4）。window 下限 8 与 app/resilience.CircuitBreaker 构造约束同轨。
LLM_BREAKER_ENABLED=true
LLM_BREAKER_WINDOW=20
LLM_BREAKER_FAILURE_RATIO=0.30
LLM_BREAKER_OPEN_SECONDS=60
LLM_BREAKER_HALF_OPEN_PROBES=3
# 云厂商占位（V2.3 不实测外呼，验收记 PENDING_EXTERNAL）：只填 key 即可启用，
# 无 key 时注册表解析层会把对应条目收成 enabled=false（enabled 由代码按 key 动态判定）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
